# 复制本文件为 .env.dev（默认开发环境）或对应的 .env.<ENV> 后填写；环境文件不要提交 Git
# 说明见 docs/环境配置说明.md

# JWT（必填）
JWT_SECRET=请替换为随机长字符串
JWT_EXPIRE_SECONDS=86400

# 数据库（应用与 Alembic 共用；相对 SQLite 路径以 src/backend 为工作目录）
# 修改后必须先显式运行 Alembic，应用/worker 不会自动迁移。
DATABASE_URL=sqlite:///./data/logistics.db

# CORS（可选，逗号分隔）
CORS_ORIGINS=http://localhost:5173

# 幂等协议（R2-02A，可按部署负载调整）
IDEMPOTENCY_PROCESSING_LEASE_SECONDS=120
IDEMPOTENCY_TTL_HOURS=24

# DeepSeek（阶段 8 接入时填写；无 Key 时 AI 功能自动降级）
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 地图与道路估算（可选；provider/key 为空时自动降级）
MAP_PROVIDER=
MAP_API_KEY=
MAP_ROAD_APPROX=false
MAP_ROAD_FACTOR=1.3
MAP_AVG_SPEED_KMH=60.0

# R2-06 JSON logs (INFO/DEBUG/WARNING)
LOG_LEVEL=INFO
