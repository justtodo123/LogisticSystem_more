# 复制本文件为 .env 后填写（.env 不要提交 Git）
# 说明见 docs/环境配置说明.md

# JWT（必填）
JWT_SECRET=请替换为随机长字符串
JWT_EXPIRE_HOURS=24

# 数据库（可选，默认 SQLite）
DATABASE_URL=sqlite:///./data/logistics.db

# CORS（可选，逗号分隔）
CORS_ORIGINS=http://localhost:5173

# DeepSeek（阶段 8 接入时填写；无 Key 时 AI 功能自动降级）
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 高德地图（P1 预留，MVP 可不填）
AMAP_ENABLED=false
AMAP_API_KEY=

# 演示模式默认（可选）
DEMO_MODE_DEFAULT=false
