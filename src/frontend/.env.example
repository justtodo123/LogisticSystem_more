# 复制为 .env.local 后使用（不要提交 Git）
# 说明见 docs/环境配置说明.md

# 开发期通常使用 Vite 代理 /api → localhost:8000，可留空
VITE_API_BASE_URL=

# 后端 auth 未就绪时设为 true，使用 Mock 登录；联调前改为 false
VITE_USE_MOCK_AUTH=true

# 基础数据 API 未就绪时设为 true；联调前改为 false
VITE_USE_MOCK_BASIC_DATA=true

# 全局调度 API 未就绪时设为 true；联调前改为 false
VITE_USE_MOCK_SCHEDULE=true

# 可选：Mock 下模拟调度无解（测试错误提示）
# VITE_MOCK_SCHEDULE_FAIL=true

# 节点间调度 API 未就绪时设为 true；联调前改为 false
VITE_USE_MOCK_NODE_DISPATCH=true

# 路线坐标 API 未就绪时设为 true；联调前改为 false
VITE_USE_MOCK_ROUTES=true

# 模拟送达 API 未就绪时设为 true；联调前改为 false
VITE_USE_MOCK_SIMULATION=true

# 异常与重规划 API 未就绪时设为 true；联调前改为 false
VITE_USE_MOCK_EXCEPTIONS=true
