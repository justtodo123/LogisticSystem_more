# 前端镜像：Vite 构建 → Nginx 托管静态文件 + 反向代理 /api
# 构建：docker build -f Dockerfile.frontend -t logistics-frontend .

# ── 构建阶段 ──
FROM node:22-alpine AS build
WORKDIR /app

COPY src/frontend/package.json src/frontend/package-lock.json ./
RUN npm ci

COPY src/frontend/ ./
RUN npm run build

# ── 运行阶段：Nginx ──
FROM nginx:1.30.4-alpine3.24

# nginx:1.27-alpine currently lands on Alpine 3.21.3 and is EOL.
# Switch to nginx 1.30.4 on Alpine 3.24 so the runtime OS layer contains fix packages.
# 安全更新：安装最新 OS 层安全补丁，减少基础镜像已知 CVE
RUN apk update && apk upgrade --no-cache

COPY src/frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
